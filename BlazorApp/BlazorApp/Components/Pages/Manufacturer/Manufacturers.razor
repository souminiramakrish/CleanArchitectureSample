@page "/manufacturer"
@inject HttpClient Http
@using BlazorApp.Shared.Models
@rendermode InteractiveServer
@inject IJSRuntime JsRuntime

<h1>Manufacturers</h1>

<p>
    <button class="btn btn-primary btn-sm mx-1" @onclick="() => OnCreate()">Create</button>
</p>


<QuickGrid ItemsProvider="@manufacturerProvider" @ref="grid"
Class="table table-bordered table-striped"
Pagination="@pagination" ItemKey="@(p => p.Id)">
    <TemplateColumn Title="Sl No.">
        @{
            int currentPage = pagination.CurrentPageIndex;
            int itemsPerPage = pagination.ItemsPerPage;
        }
        <span>
            @(currentPage * itemsPerPage + currentPageItems.IndexOf(context) + 1)
        </span>
    </TemplateColumn>
    <PropertyColumn Property="@(p => p.Name)" Sortable="true" />
    <TemplateColumn Title="Actions" Context="manufacturer">
        <button class="btn btn-primary btn-sm mx-1" @onclick="() => OnEdit(manufacturer)">Edit</button>
        <button class="btn btn-danger btn-sm mx-1" @onclick="() => OnConfirmDelete(manufacturer.Id)">Delete</button>
    </TemplateColumn>
</QuickGrid>
<Paginator State="@pagination" />


<CreateUpdateManufacturerModal @ref="modal" manufacturerId="@selectedManufacturerId" OnSave="@OnManufacturerSaved" />

@code {
    int currentPage = 1;
    int pageSize = 10;
    int totalRecords;
    GridItemsProvider<Manufacturer> manufacturerProvider;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private QuickGrid<Manufacturer> grid;
    List<Manufacturer> currentPageItems;
    int selectedManufacturerId;

    private CreateUpdateManufacturerModal modal = default!;

    protected override async Task OnInitializedAsync()
    {
        manufacturerProvider = async request =>
            {
                pageSize = request.Count ?? 10;
                currentPage = (request.StartIndex / pageSize) + 1;
                var sortBy = request.SortByColumn is not null ? request.SortByColumn.Title : null;
                if (sortBy != null)
                {
                    if (!request.SortByAscending)
                    {
                        sortBy += " desc";
                    }
                }
                var apiUrl = $"/Manufacturer/getall?pageNumber={currentPage}&pageSize={pageSize}&sortBy={sortBy}";
                var apiResult = await Http.GetFromJsonAsync<PagedResponse<Manufacturer>>(apiUrl);
                currentPageItems = apiResult.Data.ToList();
                return GridItemsProviderResult.From(currentPageItems, apiResult.TotalRecords);
            };
    }

    private async Task OnCreate()
    {
        selectedManufacturerId = 0;
        await modal.ShowModalAsync();
    }

    private async Task OnEdit(Manufacturer manufacturer)
    {
        selectedManufacturerId = manufacturer.Id;
        await modal.ShowModalAsync();
    }

    private async Task OnConfirmDelete(int id)
    {
        bool confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");
        if (confirmed)
        {
            var response = await Http.DeleteAsync($"/Manufacturer/delete/{id}");

            if (response.IsSuccessStatusCode)
            {
                await grid.RefreshDataAsync();
            }
        }
        
       
    }
    private async Task OnManufacturerSaved(bool saveStatus)
    {
        if (saveStatus)
        {
            // Refresh the grid data after a successful save
            await grid.RefreshDataAsync();
        }
    }
    

}