@using BlazorApp.Shared.Models
@inject HttpClient Http
@rendermode InteractiveServer


<Modal @ref="modal" Title="@(manufacturerId > 0 ? "Edit Manufacturer" : "Create Manufacturer")">
    <BodyTemplate>
        <div class="row">
            <EditForm Model="@manufacturer" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" class="form-control" @bind-Value="manufacturer.Name" />
                    <ValidationMessage For="@(() => manufacturer.Name)" />
                </div>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </EditForm>
        </div>
    </BodyTemplate>
</Modal>

 @code {
    [Inject] protected ToastService ToastService { get; set; } = default!;
   
    private Modal modal = default!;
    private Manufacturer manufacturer = new();

    [Parameter] public int manufacturerId { get; set; }
    [Parameter]
    public EventCallback<bool> OnSave { get; set; }
    
    protected override async Task OnParametersSetAsync()
    {
        if (manufacturerId > 0)
        {
            var apiUrl = $"/Manufacturer/getById/{manufacturerId}";
            manufacturer = await Http.GetFromJsonAsync<Manufacturer>(apiUrl);
        }
    }
    public async Task ShowModalAsync() => await modal.ShowAsync();
    private async Task HideModalAsync() => await modal.HideAsync();

    private async Task HandleValidSubmit()
    {
        // Save to database
        bool savedSuccessfully = false;
        var response = manufacturerId == 0
            ? await Http.PostAsJsonAsync($"/Manufacturer/create", manufacturer)
            : await Http.PutAsJsonAsync($"/Manufacturer/update", manufacturer);
        if (response.IsSuccessStatusCode)
        {
            // Returns the server's response as a 'ResultObject' type
            var result = await response.Content.ReadFromJsonAsync<CommandResponse>();
            if (result != null)
            {
                if (result.IsSuccess)
                    savedSuccessfully = true;

                ToastService.Notify(new(result.IsSuccess ? ToastType.Success : ToastType.Danger, result.Message));
            }
        }

        if (savedSuccessfully)
        {
            manufacturer = new Manufacturer();
            StateHasChanged();
            await OnSave.InvokeAsync(true);
            // Close the modal
            await HideModalAsync();
        }
    }
}
